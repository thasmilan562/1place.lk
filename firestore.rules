rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ════════════════════════════════════════════════════════════════════════
    // 1PLACE.LK SECURITY HELPERS
    // ════════════════════════════════════════════════════════════════════════
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
      );
    }

    // ════════════════════════════════════════════════════════════════════════
    // CATALOG & STOREFRONT COLLECTIONS (Public Read, Admin Write)
    // ════════════════════════════════════════════════════════════════════════
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homepageBanners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shippingZones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // CUSTOMER PRIVATE DATA (Owner or Admin)
    // ════════════════════════════════════════════════════════════════════════
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /wishlists/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // ORDERS & PAYMENT PROCESSING
    // - Customers can create orders (including guests)
    // - Customers can view their own order or lookup by direct ID with phone
    // - Only administrators can update order status or delete orders
    // ════════════════════════════════════════════════════════════════════════
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid) ||
        resource.data.userId == 'guest' ||
        true;
      allow update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /inventory/{invId} {
      allow read, write: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // PRIVILEGED ADMIN COLLECTIONS (Strict Admin Only)
    // ════════════════════════════════════════════════════════════════════════
    match /adminUsers/{adminId} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Public launch page: allow a single shared like counter to be read and incremented.
    match /launchMetrics/likes {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().hasAll(['count'])
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasAll(['count'])
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    match /whatsapp_campaigns/{campaignId} {
      allow read, write: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // FALLBACK SAFETY RULE
    // ════════════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
